; Tiny Tailwind project template from game-standards/templates. Compatibility renderer (E2.1), canvas_items and expand (E5.1), landscape (G6.1).
config_version=5

[application]
config/name="Tiny Tailwind"
config/version="0.3.2"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.png"
config/quit_on_go_back=false

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]
pointing/emulate_mouse_from_touch=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.06, 0.09, 0.16, 1)

[audio]
general/default_playback_type.web=1
