extends RefCounted
## One enemy. Plain data. main.gd moves it with plain maths. Built once when a map loads (E4.5).

var kind: String = ""
var label: String = ""
var pos: Vector2 = Vector2.ZERO
var home: Vector2 = Vector2.ZERO
var hp: float = 1.0
var max_hp: float = 1.0
var r: float = 16.0
var speed: float = 0.0
var move: String = "still"
var fire: String = "none"
var rate: float = 2.0
var bspeed: float = 200.0
var count: int = 1
var spread: float = 0.2
var xp: int = 1
var touch: int = 1
var color: Color = Color.WHITE
var group: String = ""
var alive: bool = true
var awake: bool = false
var dormant: bool = false
var is_add: bool = false
var phase2: bool = false
var flash: float = 0.0
var bar_t: float = 0.0                 # seconds left to show the health bar after a hit
var fire_t: float = 1.0
var state: int = 0
var st_t: float = 0.0
var ang: float = 0.0
var seed: float = 0.0
var dir: Vector2 = Vector2.RIGHT

func setup(k: String, d: Dictionary, at: Vector2, grp: String, sd: float) -> void:
	kind = k
	label = str(d.get("name", k))
	pos = at
	home = at
	max_hp = float(d.get("hp", 1))
	hp = max_hp
	r = float(d.get("r", 16))
	speed = float(d.get("speed", 0))
	move = str(d.get("move", "still"))
	fire = str(d.get("fire", "none"))
	rate = float(d.get("rate", 2.0))
	bspeed = float(d.get("bspeed", 200))
	count = int(d.get("count", 1))
	spread = float(d.get("spread", 0.2))
	xp = int(d.get("xp", 1))
	touch = int(d.get("touch", 1))
	color = Color(str(d.get("color", "#ffffff")))
	group = grp
	seed = sd
	fire_t = 0.6 + fmod(sd * 7.3, 1.2)
	alive = true
	awake = false
	state = 0
	st_t = 0.0
	flash = 0.0
	bar_t = 0.0
	phase2 = false
